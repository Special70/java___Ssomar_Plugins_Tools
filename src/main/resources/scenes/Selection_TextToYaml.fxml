<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="rootPane" prefHeight="420.0" prefWidth="615.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.sptools.ssomar_plugins_tools.controllers.TextToYamlController">
   <children>
      <VBox alignment="CENTER" prefHeight="35.0" prefWidth="600.0">
         <children>
            <Label text="Convert String to YAML Format">
               <font>
                  <Font size="16.0" />
               </font>
            </Label>
         </children>
      </VBox>
      <VBox alignment="TOP_CENTER" layoutY="35.0" prefHeight="139.0" prefWidth="613.0">
         <children>
            <Label text="Put text here">
               <font>
                  <Font size="15.0" />
               </font>
            </Label>
            <TextArea fx:id="userInput" prefHeight="200.0" prefWidth="200.0">
               <VBox.margin>
                  <Insets left="10.0" right="10.0" top="5.0" />
               </VBox.margin>
            </TextArea>
         </children>
      </VBox>
      <VBox alignment="TOP_CENTER" layoutX="2.0" layoutY="200.0" prefHeight="139.0" prefWidth="613.0">
         <children>
            <Label text="Converted YAML Text Here">
               <font>
                  <Font size="15.0" />
               </font>
            </Label>
            <TextArea fx:id="outputField" prefHeight="200.0" prefWidth="200.0">
               <VBox.margin>
                  <Insets left="10.0" right="10.0" top="5.0" />
               </VBox.margin>
            </TextArea>
         </children>
      </VBox>
      <VBox alignment="CENTER" layoutX="-2.0" layoutY="366.0" prefHeight="49.0" prefWidth="617.0">
         <children>
            <Button fx:id="backButton" mnemonicParsing="false" onAction="#backToMainPage" text="Back" />
         </children>
      </VBox>
   </children>
</AnchorPane>
